NODE_ENV=development
PORT=5000
API_VERSION=v1
API_RATE_LIMIT_MAX=300
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subscription_management
DB_POOL_MAX=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
DEFAULT_CURRENCY=USD
PUBLIC_APP_URL=http://localhost:5173
DB_SSL_CA=

# Set a verified sender/domain before enabling production email.
RESEND_API_KEY=
EMAIL_FROM=
# Optional generic mail service fallback; receives { to, subject, text }.
EMAIL_API_URL=
EMAIL_API_KEY=
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
